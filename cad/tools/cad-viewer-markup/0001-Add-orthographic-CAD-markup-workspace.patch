+    viewerVersion: "0.3.2",
+    registryServers: [],
+    portScanLimit: 2,
+    probePort: async ({ host, port }) => {
+      probes.push(port);
+      if (port === 4178) {
+        return {
+          status: "viewer",
+          port,
+          baseUrl: `http://${host}:${port}`,
+          serverInfo: {
+            app: "cad-viewer",
+            serverApiVersion: 2,
+            dynamicRoot: true,
+            serverFeatures: ["directory-activation"],
+            serverMode: "serve",
+            viewerVersion: "0.3.2",
+          },
+        };
+      }
